# =============================================================
# Sys-AIMS 환경변수 템플릿
# 사용법: cp .env.example .env 후 실제 값을 채운다.
# ⚠️ .env는 절대 커밋하지 않는다 (.gitignore 등록됨).
# =============================================================

# ---------- 실행 환경 ----------
# 아래 APP_ENV / DOMAIN 은 기록용이다. 컨테이너나 스크립트가 읽지 않는다.
# 도메인을 바꿀 때 실제로 고쳐야 하는 곳은 nginx/conf.d/prod/10-https.conf.off
# (server_name 1곳 + 인증서 경로 2곳)와 아래 REPORT_BASE_URL 이다.
# 실행 환경 구분: local (HTTP, 맥북 개발) | prod (HTTPS, AWS EC2)
APP_ENV=
# 서비스 도메인. local이면 localhost, prod이면 sys-aims.duckdns.org
DOMAIN=
# 컨테이너 타임존 (기본값: Asia/Seoul)
TZ=

# ---------- PostgreSQL (Zabbix DB) ----------
# Zabbix Server/Web이 사용하는 DB 계정
POSTGRES_USER=
# DB 비밀번호. 충분히 긴 무작위 문자열을 사용할 것
POSTGRES_PASSWORD=
# Zabbix DB 이름
POSTGRES_DB=

# ---------- Zabbix API (Python 자동화 스크립트용) ----------
# Zabbix Web의 JSON-RPC 엔드포인트 (예: http://<zabbix-web 호스트>/api_jsonrpc.php)
ZABBIX_API_URL=
# API 호출 전용 계정 (Admin 기본 계정 대신 최소 권한 계정 권장)
ZABBIX_API_USER=
# 위 계정의 비밀번호
ZABBIX_API_PASSWORD=

# ---------- OpenAI (RCA / 일일점검 보고서) ----------
# OpenAI API 키
OPENAI_API_KEY=
# 사용할 모델명
OPENAI_MODEL=

# ---------- Slack ----------
# RCA 결과와 알림을 보낼 Incoming Webhook URL
SLACK_WEBHOOK_URL=

# ---------- DuckDNS (prod 전용) ----------
# DuckDNS 서브도메인 (.duckdns.org를 뺀 이름, 예: sys-aims)
DUCKDNS_DOMAIN=
# DuckDNS 계정 토큰 (IP 갱신용)
DUCKDNS_TOKEN=
# IP 갱신 주기(초). 비우면 300. 탄력적 IP 없이 쓰므로 중지/시작 후 이 주기 안에 복구된다
DUCKDNS_INTERVAL_SECONDS=

# ---------- 모니터링 대상 ----------
# Self-Healing, RCA 대상 컨테이너 이름
TARGET_CONTAINER=
# 감시 대상 VM 의 액티브 에이전트를 받을 주소 (zabbix-server 10051 바인딩).
# 비우면 127.0.0.1 — VM 을 붙일 때만 mon 의 **사설 IP** 를 넣는다 (0.0.0.0 금지).
ZABBIX_SERVER_BIND=

# ---------- 호스트 바인딩 포트 (127.0.0.1 전용) ----------
# Zabbix Web UI 포트 (예: 8080). prod에서도 루프백에만 열어
# 호스트의 scripts/zabbix_config.py 가 API를 호출한다 (외부 공개는 Nginx가 담당)
ZABBIX_WEB_PORT=
# pitwall_web 직접 접근 포트 (예: 8081). local override 전용
PITWALL_WEB_PORT=

# ---------- Self-Healing (healer) ----------
# Zabbix → healer 호출 인증 토큰. 생성: openssl rand -hex 32
HEALER_TOKEN=
# 서킷 브레이커: WINDOW 초 안에 MAX_RESTARTS 회를 넘으면 자동 복구 중단 (기본 3회 / 600초)
HEALER_MAX_RESTARTS=
HEALER_WINDOW_SECONDS=
# 같은 컨테이너에 대한 중복 요청 무시 시간 (기본 60초)
HEALER_COOLDOWN_SECONDS=
# docker.sock 소유 그룹 GID (socket-proxy가 비root로 소켓에 접근하기 위함)
#   맥 Docker Desktop: 0   /   EC2: getent group docker | cut -d: -f3
DOCKER_GID=

# ---------- RCA (AI 장애 분석) ----------
# healer → rca 내부 호출 인증 토큰 (HEALER_TOKEN과 반드시 다른 값). 생성: openssl rand -hex 32
RCA_TOKEN=
# 비용 상한 (근거: docs/rca.md). 기본값 20 / 12000 / 1200
#   하루 최대 AI 분석 횟수
RCA_MAX_PER_DAY=
#   OpenAI에 보내는 로그 최대 글자 수 (노이즈 압축 후, 최신 줄 우선)
RCA_MAX_LOG_CHARS=
#   응답 최대 토큰 (추론 토큰 포함)
RCA_MAX_OUTPUT_TOKENS=

# ---------- 일일 점검 보고서 (reporter) ----------
# 보고서 전용 Zabbix 읽기 전용 계정 (scripts/zabbix_config.py apply/import 가 생성)
ZABBIX_REPORT_USER=
# 위 계정 비밀번호. 생성: openssl rand -base64 30
ZABBIX_REPORT_PASSWORD=
# Slack 알림에 넣을 보고서 링크의 베이스 URL (예: https://sys-aims.duckdns.org/reports)
# 비우면 링크 대신 파일명만 표시된다. local에서는 비워 둔다
REPORT_BASE_URL=
# 매일 보고서 생성 시각 (TZ 기준, HH:MM). 기본 08:00
REPORT_TIME=
# 비용 상한 (근거: docs/daily-report.md). 기본 5 / 2000
#   하루 최대 보고서 생성 횟수 (정기 + 수동 실행 합산, OpenAI 호출 기준)
REPORT_MAX_PER_DAY=
#   응답 최대 토큰 (추론 토큰 포함)
REPORT_MAX_OUTPUT_TOKENS=
# 정기 보고서 보관 일수 (수동 실행 보고서는 7일). 기본 90
REPORT_RETENTION_DAYS=
